{
  "name": "agent-bookshelf",
  "version": "1.0.0",
  "description": "Goodreads-lite teaching playground for AI agents course",
  "type": "module",
  "bin": {
    "agent-bookshelf": "./bin/agent-bookshelf.js"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "test": "vitest",
    "test:run": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:report": "playwright show-report"
  },
  "keywords": [
    "goodreads",
    "books",
    "ai-agents",
    "teaching",
    "playground"
  ],
  "author": "",
  "license": "GPL-3.0",
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "@qdrant/js-client-rest": "^1.19.0",
    "better-sqlite3": "^11.7.0",
    "ejs": "^3.1.10",
    "express": "^4.21.2",
    "htmx.org": "^1.9.12",
    "ollama": "^0.6.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/better-sqlite3": "^7.6.12",
    "@types/ejs": "^3.1.5",
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.2",
    "@types/supertest": "^6.0.2",
    "supertest": "^7.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
